<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Simple To-Do List</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main>
    <section id="newtask">
      <h2>My To Do List</h2>
      <input type="text" id="taskInput" placeholder="Add a new task..." disabled>
      <button disabled>Add Task</button>
    </section>
    <section id="tasks">
      <ul>
        <li>Hit the gym</li>
        <li>Pay bills</li>
        <li>Read a book</li>
        <li>Organize notes</li>
      </ul>
    </section>
  </main>
</body>
</html>
